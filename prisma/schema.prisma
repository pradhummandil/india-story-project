generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Author {
  id         String     @id @default(uuid()) @db.Uuid
  name       String
  bio        String?
  avatar     String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  follows    Follow[]
  stories    Story[]
  videos     Video[]
  webStories WebStory[]

  @@index([name])
}

model UserProfile {
  id               String            @id @db.Uuid
  email            String            @unique
  name             String?
  avatarUrl        String?
  bio              String?
  role             UserRole          @default(Reader)
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  coverUrl         String?
  favoriteState    String?
  instagram        String?
  lastActiveAt     DateTime?
  level            Int               @default(1)
  linkedin         String?
  readingStreak    Int               @default(0)
  totalReadingTime Int               @default(0)
  totalXP          Int               @default(0)
  twitter          String?
  website          String?
  favoriteTheme    String?
  audioProgress    AudioProgress[]
  bookmarks        Bookmark[]
  challengeEntries ChallengeEntry[]
  collections      Collection[]
  comments         Comment[]
  commentLikes     CommentLike[]
  commentReports   CommentReport[]
  discussionPosts  DiscussionPost[]
  discussionTopics DiscussionTopic[]
  follows          Follow[]          @relation("UserFollows")
  groupMemberships GroupMember[]
  postReactions    PostReaction[]
  postReports      PostReport[]
  readingProgress  ReadingProgress[]
  searchHistory    SearchHistory[]
  likes            StoryLike[]
  submissions      SubmittedStory[]
  userBadges       UserBadge[]
  mentionsSent     UserMention[]     @relation("MentionedBy")
  mentionsReceived UserMention[]     @relation("MentionedUser")
  userStat         UserStat?

  @@index([role])
  @@index([totalXP])
  @@index([readingStreak])
}

model SiteSetting {
  key       String   @id
  value     String
  label     String?
  updatedAt DateTime @updatedAt
}

model Theme {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  slug      String       @unique
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  stories   StoryTheme[]
  videos    VideoTheme[]

  @@index([slug])
}

model StoryTheme {
  storyId   String   @db.Uuid
  themeId   String   @db.Uuid
  createdAt DateTime @default(now())
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  theme     Theme    @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([storyId, themeId])
  @@index([themeId])
}

model State {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cities    City[]
  stories   Story[]
  videos    Video[]

  @@index([name])
  @@index([latitude, longitude])
}

model City {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  stateId   String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  state     State    @relation(fields: [stateId], references: [id])
  stories   Story[]

  @@index([stateId])
}

model Tag {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  slug      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  stories   StoryTag[]

  @@index([name])
}

model Story {
  id                String            @id @default(uuid()) @db.Uuid
  sourceId          String?           @unique
  slug              String            @unique
  title             String
  excerpt           String
  content           String
  publishedAt       DateTime?
  readingTime       Int?
  seoTitle          String?
  seoDescription    String?
  featured          Boolean           @default(false)
  heroOfTheDay      Boolean           @default(false)
  status            StoryStatus       @default(Draft)
  authorId          String            @db.Uuid
  stateId           String            @db.Uuid
  cityId            String?           @db.Uuid
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  contentHi         String?
  excerptHi         String?
  scheduledAt       DateTime?
  titleHi           String?
  viewCount         Int               @default(0)
  deleted           Boolean           @default(false)
  homepageSlideshow Boolean           @default(false)
  seoKeywords       String?
  shares            Int               @default(0)
  slideshowOrder    Int               @default(0)
  version           Int               @default(1)
  editorsPick       Boolean           @default(false)
  pinnedStory       Boolean           @default(false)
  readingPriority   Int               @default(0)
  seoPriority       Float             @default(0.5)
  trendingStory     Boolean           @default(false)
  audioProgress     AudioProgress[]
  bookmarks         Bookmark[]
  challengeEntries  ChallengeEntry[]
  collections       CollectionStory[]
  comments          Comment[]
  featuredIn        FeaturedStory[]
  heroSlides        HeroSlide[]
  pageViews         PageView[]
  readingProgress   ReadingProgress[]
  author            Author            @relation(fields: [authorId], references: [id])
  city              City?             @relation(fields: [cityId], references: [id])
  state             State             @relation(fields: [stateId], references: [id])
  images            StoryImage[]
  likes             StoryLike[]
  revisions         StoryRevision[]
  tags              StoryTag[]
  themes            StoryTheme[]
  views             StoryView[]

  @@index([slug])
  @@index([status])
  @@index([publishedAt])
  @@index([featured])
  @@index([heroOfTheDay])
  @@index([pinnedStory])
  @@index([trendingStory])
  @@index([editorsPick])
  @@index([viewCount])
  @@index([stateId])
  @@index([authorId])
  @@index([homepageSlideshow, slideshowOrder])
  @@index([createdAt])
  @@index([updatedAt])
}

model StoryTag {
  storyId   String   @db.Uuid
  tagId     String   @db.Uuid
  createdAt DateTime @default(now())
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([storyId, tagId])
  @@index([tagId])
}

model StoryImage {
  id        String   @id @default(uuid()) @db.Uuid
  storyId   String   @db.Uuid
  imageUrl  String
  caption   String?
  sortOrder Int      @default(0)
  heroImage Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, sortOrder])
  @@index([storyId])
  @@index([heroImage])
}

model StoryView {
  id        String   @id @default(uuid()) @db.Uuid
  storyId   String   @db.Uuid
  ipAddress String?
  createdAt DateTime @default(now())
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId])
}

model Bookmark {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  storyId   String      @db.Uuid
  createdAt DateTime    @default(now())
  story     Story       @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId])
  @@index([userId])
  @@index([storyId])
}

model StoryLike {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  storyId   String      @db.Uuid
  createdAt DateTime    @default(now())
  story     Story       @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId])
  @@index([userId])
  @@index([storyId])
}

model ReadingProgress {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String      @db.Uuid
  storyId         String      @db.Uuid
  progressPercent Int         @default(0)
  scrollPosition  Int         @default(0)
  completed       Boolean     @default(false)
  lastReadAt      DateTime    @default(now())
  story           Story       @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user            UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId])
  @@index([userId])
  @@index([storyId])
  @@index([completed])
  @@index([lastReadAt])
}

model UserStat {
  id               String      @id @default(uuid()) @db.Uuid
  userId           String      @unique @db.Uuid
  storiesRead      Int         @default(0)
  storiesLiked     Int         @default(0)
  bookmarksCount   Int         @default(0)
  readingStreak    Int         @default(0)
  longestStreak    Int         @default(0)
  totalXP          Int         @default(0)
  level            Int         @default(1)
  weeklyXP         Int         @default(0)
  monthlyXP        Int         @default(0)
  totalReadingTime Int         @default(0)
  lastActiveAt     DateTime?
  updatedAt        DateTime    @updatedAt
  user             UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([totalXP])
  @@index([readingStreak])
}

model Badge {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  slug        String      @unique
  description String
  icon        String
  color       String      @default("#C8A96A")
  criteria    Json
  rarity      String      @default("common")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  userBadges  UserBadge[]

  @@index([slug])
}

model UserBadge {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  badgeId   String      @db.Uuid
  awardedAt DateTime    @default(now())
  badge     Badge       @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([awardedAt])
}

model HeroSlide {
  id        String   @id @default(uuid()) @db.Uuid
  storyId   String   @db.Uuid
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  caption   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([active, sortOrder])
}

model FeaturedStory {
  id        String   @id @default(uuid()) @db.Uuid
  storyId   String   @db.Uuid
  section   String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([section, active, sortOrder])
}

model Profile {
  id        String   @id @db.Uuid
  email     String   @unique
  fullName  String?  @map("full_name")
  avatarUrl String?  @map("avatar_url")
  role      String   @default("user")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  active    Boolean  @default(true)

  @@map("profiles")
}

model Comment {
  id        String          @id @default(uuid()) @db.Uuid
  storyId   String          @db.Uuid
  userId    String          @db.Uuid
  content   String
  parentId  String?         @db.Uuid
  status    String          @default("approved")
  edited    Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  parent    Comment?        @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]       @relation("CommentReplies")
  story     Story           @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      UserProfile     @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes     CommentLike[]
  reports   CommentReport[]

  @@index([storyId])
  @@index([userId])
  @@index([parentId])
}

model CommentLike {
  id        String      @id @default(uuid()) @db.Uuid
  commentId String      @db.Uuid
  userId    String      @db.Uuid
  createdAt DateTime    @default(now())
  comment   Comment     @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
}

model CommentReport {
  id        String      @id @default(uuid()) @db.Uuid
  commentId String      @db.Uuid
  userId    String      @db.Uuid
  reason    String
  createdAt DateTime    @default(now())
  comment   Comment     @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
}

model SubmittedStory {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  title          String
  excerpt        String
  content        String
  titleHi        String?
  excerptHi      String?
  contentHi      String?
  stateName      String
  cityName       String?
  authorName     String?
  imageUrl       String?
  imageCaption   String?
  status         SubmissionStatus @default(Pending)
  adminNotes     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  district       String?
  email          String?
  externalLinks  String?
  galleryUrls    String?
  heroName       String?
  language       String           @default("en")
  videoUrl       String?
  phone          String?
  seoDescription String?
  seoKeywords    String?
  seoTitle       String?
  tags           String?
  themes         String?
  user           UserProfile      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model NewsletterSubscriber {
  id                String   @id @default(uuid()) @db.Uuid
  email             String   @unique
  verified          Boolean  @default(false)
  status            String   @default("active")
  language          String   @default("en")
  verificationToken String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([email])
  @@index([verified])
  @@index([status])
}

model ContactMessage {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  email        String
  subject      String
  message      String
  ipAddress    String?
  userAgent    String?
  country      String?
  status       String    @default("unread")
  replyContent String?
  repliedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model Video {
  id        String       @id @default(uuid()) @db.Uuid
  title     String
  titleHi   String?
  excerpt   String?
  excerptHi String?
  slug      String       @unique
  videoUrl  String
  provider  String       @default("youtube")
  duration  Int          @default(0)
  viewCount Int          @default(0)
  thumbnail String?
  featured  Boolean      @default(false)
  status    StoryStatus  @default(Draft)
  authorId  String       @db.Uuid
  stateId   String       @db.Uuid
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  author    Author       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  state     State        @relation(fields: [stateId], references: [id], onDelete: Cascade)
  themes    VideoTheme[]
}

model VideoTheme {
  videoId String @db.Uuid
  themeId String @db.Uuid
  theme   Theme  @relation(fields: [themeId], references: [id], onDelete: Cascade)
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([videoId, themeId])
}

model WebStory {
  id         String         @id @default(uuid()) @db.Uuid
  title      String
  titleHi    String?
  slug       String         @unique
  coverImage String
  excerpt    String?
  status     StoryStatus    @default(Draft)
  viewCount  Int            @default(0)
  authorId   String         @db.Uuid
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  author     Author         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  pages      WebStoryPage[]
}

model WebStoryPage {
  id         String   @id @default(uuid()) @db.Uuid
  storyId    String   @db.Uuid
  imageUrl   String
  heading    String?
  headingHi  String?
  text       String?
  textHi     String?
  sortOrder  Int      @default(0)
  durationMs Int      @default(5000)
  story      WebStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
}

model Follow {
  followerId String      @db.Uuid
  authorId   String      @db.Uuid
  createdAt  DateTime    @default(now())
  author     Author      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  follower   UserProfile @relation("UserFollows", fields: [followerId], references: [id], onDelete: Cascade)

  @@id([followerId, authorId])
}

model Collection {
  id        String            @id @default(uuid()) @db.Uuid
  name      String
  userId    String            @db.Uuid
  createdAt DateTime          @default(now())
  user      UserProfile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  stories   CollectionStory[]
}

model CollectionStory {
  collectionId String     @db.Uuid
  storyId      String     @db.Uuid
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  story        Story      @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@id([collectionId, storyId])
}

model StoryRevision {
  id        String   @id @default(uuid()) @db.Uuid
  storyId   String   @db.Uuid
  title     String
  excerpt   String
  content   String
  changedBy String   @db.Uuid
  version   Int
  createdAt DateTime @default(now())
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  action    String
  details   String
  createdAt DateTime @default(now())
}

model DiscussionCategory {
  id          String            @id @default(uuid()) @db.Uuid
  name        String
  slug        String            @unique
  description String?
  icon        String            @default("💬")
  color       String            @default("#C8A96A")
  sortOrder   Int               @default(0)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  topics      DiscussionTopic[]

  @@index([slug])
  @@index([sortOrder])
}

model DiscussionTopic {
  id             String              @id @default(uuid()) @db.Uuid
  title          String
  content        String
  userId         String              @db.Uuid
  categoryId     String?             @db.Uuid
  isPinned       Boolean             @default(false)
  isTrending     Boolean             @default(false)
  isLocked       Boolean             @default(false)
  isSpam         Boolean             @default(false)
  viewCount      Int                 @default(0)
  replyCount     Int                 @default(0)
  reportCount    Int                 @default(0)
  lastActivityAt DateTime            @default(now())
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  posts          DiscussionPost[]
  category       DiscussionCategory? @relation(fields: [categoryId], references: [id])
  user           UserProfile         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([isPinned])
  @@index([isTrending])
  @@index([lastActivityAt])
  @@index([viewCount])
}

model DiscussionPost {
  id               String          @id @default(uuid()) @db.Uuid
  topicId          String          @db.Uuid
  userId           String          @db.Uuid
  content          String
  parentId         String?         @db.Uuid
  isPinned         Boolean         @default(false)
  isSpam           Boolean         @default(false)
  reportCount      Int             @default(0)
  mentionedUserIds String[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  topic            DiscussionTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user             UserProfile     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reactions        PostReaction[]
  reports          PostReport[]
  mentions         UserMention[]

  @@index([topicId])
  @@index([userId])
  @@index([parentId])
  @@index([isSpam])
}

model PostReaction {
  id        String         @id @default(uuid()) @db.Uuid
  postId    String         @db.Uuid
  userId    String         @db.Uuid
  emoji     String
  createdAt DateTime       @default(now())
  post      DiscussionPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      UserProfile    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, emoji])
  @@index([postId])
  @@index([userId])
}

model PostReport {
  id        String         @id @default(uuid()) @db.Uuid
  postId    String         @db.Uuid
  userId    String         @db.Uuid
  reason    String
  details   String?
  resolved  Boolean        @default(false)
  createdAt DateTime       @default(now())
  post      DiscussionPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      UserProfile    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([resolved])
}

model UserMention {
  id                String         @id @default(uuid()) @db.Uuid
  postId            String         @db.Uuid
  mentionedUserId   String         @db.Uuid
  mentionedByUserId String         @db.Uuid
  isRead            Boolean        @default(false)
  createdAt         DateTime       @default(now())
  mentionedByUser   UserProfile    @relation("MentionedBy", fields: [mentionedByUserId], references: [id], onDelete: Cascade)
  mentionedUser     UserProfile    @relation("MentionedUser", fields: [mentionedUserId], references: [id], onDelete: Cascade)
  post              DiscussionPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([mentionedUserId])
  @@index([isRead])
}

model CommunityGroup {
  id            String                  @id @default(uuid()) @db.Uuid
  name          String
  slug          String                  @unique
  description   String
  coverUrl      String?
  avatarUrl     String?
  privacy       String                  @default("public")
  memberCount   Int                     @default(0)
  isActive      Boolean                 @default(true)
  createdBy     String                  @db.Uuid
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  announcements CommunityAnnouncement[]
  members       GroupMember[]

  @@index([slug])
  @@index([privacy])
  @@index([memberCount])
}

model GroupMember {
  id       String         @id @default(uuid()) @db.Uuid
  groupId  String         @db.Uuid
  userId   String         @db.Uuid
  role     String         @default("member")
  joinedAt DateTime       @default(now())
  group    CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     UserProfile    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

model StoryChallenge {
  id          String           @id @default(uuid()) @db.Uuid
  title       String
  slug        String           @unique
  description String
  rules       String
  theme       String?
  prize       String?
  badgeId     String?          @db.Uuid
  startAt     DateTime
  endAt       DateTime
  isActive    Boolean          @default(true)
  isFeatured  Boolean          @default(false)
  createdBy   String           @db.Uuid
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  entries     ChallengeEntry[]

  @@index([slug])
  @@index([endAt])
  @@index([isActive])
}

model ChallengeEntry {
  id          String         @id @default(uuid()) @db.Uuid
  challengeId String         @db.Uuid
  userId      String         @db.Uuid
  storyId     String?        @db.Uuid
  storyTitle  String?
  storyUrl    String?
  votes       Int            @default(0)
  rank        Int?
  isWinner    Boolean        @default(false)
  createdAt   DateTime       @default(now())
  challenge   StoryChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  story       Story?         @relation(fields: [storyId], references: [id])
  user        UserProfile    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([challengeId])
  @@index([votes])
  @@index([isWinner])
}

model CommunityAnnouncement {
  id        String          @id @default(uuid()) @db.Uuid
  groupId   String?         @db.Uuid
  title     String
  content   String
  createdBy String          @db.Uuid
  isGlobal  Boolean         @default(false)
  expiresAt DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  group     CommunityGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([isGlobal])
}

model PageView {
  id            String   @id @default(uuid()) @db.Uuid
  sessionId     String
  userId        String?
  path          String
  storyId       String?  @db.Uuid
  themeSlug     String?
  authorId      String?  @db.Uuid
  referrer      String?
  trafficSource String?
  country       String?
  state         String?
  city          String?
  deviceType    String?
  browser       String?
  scrollDepth   Int      @default(0)
  readingTime   Int      @default(0)
  completed     Boolean  @default(false)
  isReturn      Boolean  @default(false)
  createdAt     DateTime @default(now())
  story         Story?   @relation(fields: [storyId], references: [id])

  @@index([path])
  @@index([storyId])
  @@index([sessionId])
  @@index([trafficSource])
  @@index([country])
  @@index([createdAt])
}

model AudioProgress {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @db.Uuid
  storyId     String      @db.Uuid
  currentTime Float       @default(0)
  duration    Float       @default(0)
  language    String      @default("en")
  voiceId     String      @default("female")
  completed   Boolean     @default(false)
  updatedAt   DateTime    @updatedAt
  createdAt   DateTime    @default(now())
  story       Story       @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user        UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId, language, voiceId])
  @@index([userId])
  @@index([storyId])
  @@index([updatedAt])
}

model SearchHistory {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  query     String
  createdAt DateTime    @default(now())
  user      UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model SearchQueryTracker {
  id        String   @id @default(uuid()) @db.Uuid
  query     String   @unique
  count     Int      @default(1)
  updatedAt DateTime @updatedAt

  @@index([count])
}

enum StoryStatus {
  Draft
  Published
  Archived
  Pending
  Hidden
}

enum SubmissionStatus {
  Pending
  Approved
  Rejected
  UnderReview
  FactChecking
  ChangesRequested
  Published
  Draft
}

enum UserRole {
  SuperAdmin
  Admin
  Editor
  Author
  Reader
}
